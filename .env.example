NODE_ENV=development

# ---------- API ----------
API_PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# Postgres. Locally: docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
# In production this is the Neon POOLED connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailer?schema=public"

# ---------- mail ----------
# file = write .eml files to disk (no mail server needed)
# smtp = hand off to a real SMTP server (fill in SMTP_* below)
MAIL_TRANSPORT=file
MAIL_OUTPUT_DIR=./storage/mail

MAIL_FROM_NAME=Mail Sender
MAIL_FROM_ADDRESS=no-reply@localhost

# Only used when MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Recipients processed per batch during a campaign send
SEND_BATCH_SIZE=50


# ---------------------------------------------------------------------------
# Production reference - do NOT put these in this file, set them on the host.
# The API's values live in the Render dashboard, the web's in Vercel.
# See docs/deployment.md.
# ---------------------------------------------------------------------------
#
# Render (API):
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   CORS_ORIGINS=https://your-app.vercel.app
#   MAIL_TRANSPORT=smtp
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_your_resend_api_key
#   MAIL_FROM_ADDRESS=no-reply@your-verified-domain.com
#
# Vercel (web):
#   VITE_API_URL=https://mail-sender-api.onrender.com/api

NODE_ENV=development

# ---------- API ----------
API_PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# Postgres. Locally: docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
# In production this is the Neon POOLED connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailer?schema=public"

# ---------- Google OAuth ----------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). See docs/deployment.md step 6.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must be listed verbatim under "Authorised redirect URIs" on that client.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Where the API sends the browser back once a token is signed: the dashboard,
# not the API.
WEB_APP_URL=http://localhost:5173

# Signing key for the session JWT. Generate with: openssl rand -base64 32
# Rotating this immediately invalidates every outstanding session.
JWT_SECRET=generate-me-openssl-rand-base64-32
JWT_EXPIRES_IN=7d

# Comma-separated addresses allowed to sign in. Blank accepts ANY Google
# account - which is the current setting, so treat the dashboard URL as
# semi-public until you fill this in.
AUTH_ALLOWED_EMAILS=

# ---------- mail ----------
# file = write .eml files to disk (no mail server needed)
# smtp = hand off to a real SMTP server (fill in SMTP_* below)
MAIL_TRANSPORT=file
MAIL_OUTPUT_DIR=./storage/mail

MAIL_FROM_NAME=Mail Sender
MAIL_FROM_ADDRESS=no-reply@localhost

# Only used when MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Recipients processed per batch during a campaign send
SEND_BATCH_SIZE=50


